{
  "manifest_version": 3,
  "name": "YenTick",
  "version": "1.0.0",
  "description": "現在のドル円為替レートおよび過去24時間の価格推移を即座に提供するChrome拡張機能。",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "assets/icon-128.png"
  },
  "icons": {
    "16": "assets/icon-128.png",
    "48": "assets/icon-128.png",
    "128": "assets/icon-128.png"
  }
}


